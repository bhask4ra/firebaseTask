rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleccion tasks: cada documento pertenece a un usuario via ownerUid.
    // - Solo el dueno (request.auth.uid == ownerUid) puede leer sus propias tareas.
    // - Al crear, el ownerUid del nuevo documento debe coincidir con el uid autenticado.
    // - Al actualizar o eliminar, el ownerUid del documento existente debe coincidir
    //   con el uid autenticado, y no se puede reasignar la tarea a otro usuario.
    // - Se valida tambien que los campos requeridos tengan el tipo correcto.

    match /tasks/{taskId} {
      allow read: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.completed is bool
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.completed is bool;

      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Cualquier otra ruta queda denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
